    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. Safe extraction with strict string casting fallbacks\nlet firstName = String($json[\"First Name\"] || '').trim();\nlet lastName = String($json[\"Last Name\"] || '').trim();\nlet email = String($json[\"Email\"] || '').trim().toLowerCase();\n\n// Coerces number values safely to text before running trim\nlet rawPhone = ($json[\"Contact Number\"] !== undefined && $json[\"Contact Number\"] !== null) ? $json[\"Contact Number\"].toString().trim() : '';\nlet propertyInterest = String($json[\"Property you're interested\"] || '').trim();\n\n// 2. Proper Case Formatter\nconst toProperCase = (str) => {\n  return str.toLowerCase().replace(/\\b\\w/g, c => c.toUpperCase());\n};\n\nfirstName = toProperCase(firstName);\nlastName = toProperCase(lastName);\nlet fullName = `${firstName} ${lastName}`;\n\n// 3. Normalize Phone Numbers\nlet cleanPhone = rawPhone.replace(/[-() ]/g, '');\nif (cleanPhone.startsWith('0')) {\n  cleanPhone = '+63' + cleanPhone.slice(1);\n} else if (cleanPhone.startsWith('63') && !cleanPhone.startsWith('+')) {\n  cleanPhone = '+' + cleanPhone;\n}\n\n// 4. Structural Checks\nconst isEmailValid = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\nconst hasRequiredFields = firstName.length > 0 && lastName.length > 0 && isEmailValid;\n\n// 5. Output\nreturn {\n  ...$json,\n  formattedFirstName: firstName,\n  formattedLastName: lastName,\n  formattedFullName: fullName,\n  transformedEmail: email,\n  transformedPhone: cleanPhone || 'Not Provided',\n  sanitizedPropertyNotes: propertyInterest || 'No specific property listed',\n  isValidLead: hasRequiredFields\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
